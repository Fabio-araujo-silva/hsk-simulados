acuna","resposta":"A","grupo":"R4","linhas":[{"zh":"男：你昨天（＿＿）没去看电影？","tk":["男","：","你","昨天","（＿＿）","没","去","看","电影","？"],"py":["nán","","nǐ","zuótiān","","méi","qù","kàn","diànyǐng",""],"ptL":"Homem: Ontem você ___ não foi ao cinema?","pt":"Homem: Por que você não foi ao cinema ontem?"},{"zh":"女：对不起，昨天我去看医生了。","tk":["女","：","对不起","，","昨天","我","去","看","医生","了","。"],"py":["nǚ","","duìbùqǐ","","zuótiān","wǒ","qù","kàn","yīshēng","le",""],"pt":"Mulher: Desculpe, ontem eu fui ao médico."}],"explicacao":"怎么没去 = \"por que não foi\". Ela responde com o motivo: foi ao médico. Por isso a palavra é 怎么.","trecho":"我去看医生了","palavras":["怎么","看电影"]}]}