{
  "name": "hsk-simulados",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulados reais do HSK 1–3 (2.0) e do HSKK 中级 (prova oral) com modo prova, modo estudo, áudio sincronizado, tradução por hover, gravação da voz com correção automática e revisão espaçada.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^4.7.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
